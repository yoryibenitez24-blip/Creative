{
  "//": "Type-check the Edge Functions with Node's tsc against the real stripe / supabase-js typings (no Deno needed). See typecheck/README.",
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true,
    "noUnusedLocals": true, "erasableSyntaxOnly": true, "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "npm:stripe@23.1.0": ["node_modules/stripe"],
      "npm:@supabase/supabase-js@2.119.0": ["node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["deno-shim.d.ts", "../supabase/functions/**/*.ts"]
}
